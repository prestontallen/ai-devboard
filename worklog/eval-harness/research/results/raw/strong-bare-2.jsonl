{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qdcu1mb8JMU1tuuwjkEeba","type":"tool_result","content":"1\tpackage cli\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"os\"\n6\t\t\"strings\"\n7\t\n8\t\t\"github.com/prestontallen/ai-devboard/worklog/internal/devboard\"\n9\t\t\"github.com/prestontallen/ai-devboard/worklog/internal/migrate\"\n10\t\t\"github.com/prestontallen/ai-devboard/worklog/internal/model\"\n11\t\t\"github.com/prestontallen/ai-devboard/worklog/internal/projection\"\n12\t\t\"github.com/prestontallen/ai-devboard/worklog/internal/reindex\"\n13\t\t\"github.com/prestontallen/ai-devboard/worklog/internal/store\"\n14\t\t\"github.com/prestontallen/ai-devboard/worklog/internal/store/sqlitestore\"\n15\t)\n16\t\n17\t// nextRank is the Rank a newly created ticket must carry: one past the\n18\t// highest rank among live tickets, so it renders at the END of its\n19\t// section.\n20\t//\n21\t// Leaving it at the zero value is not \"unranked\" — it is the literal\n22\t// rank of whichever ticket sits first in WORK.md, because convert\n23\t// numbers document position from zero (convert/workmd.go:73). A new\n24\t// ticket defaulting to 0 therefore *ties* the first ticket, and\n25\t// Tickets() breaks that tie with `ORDER BY rank, slug` — so the new\n26\t// ticket silently sorts by alphabetical luck instead of landing where\n27\t// the human put it. Observed live: a ticket added on 2026-09-03 tied\n28\t// adb-research-mode at rank 0 and won the slug comparison, jumping to\n29\t// the top of ## Now.\n30\t//\n31\t// Archived tickets are excluded: their Rank is a position within an\n32\t// archive month, a different numbering space that says nothing about\n33\t// where a live ticket belongs.\n34\tfunc nextRank(s store.Store) (int, error) {\n35\t\ttickets, err := s.Tickets()\n36\t\tif err != nil {\n37\t\t\treturn 0, err\n38\t\t}\n39\t\tmax := -1\n40\t\tfor _, t := range tickets {\n41\t\t\tif !t.Archived && t.Rank > max {\n42\t\t\t\tmax = t.Rank\n43\t\t\t}\n44\t\t}\n45\t\treturn max + 1, nil\n46\t}\n47\t\n48\t// nextRosterRank is nextRank for an epic's child roster. Same collision,\n49\t// one level down: RosterRank is assigned only by convert (convert.go:161,\n50\t// :181), so a child added through the CLI defaults to 0, ties the epic's\n51\t// first child, and is ordered against it by slug.\n52\tfunc nextRosterRank(s store.Store, parent store.ID) (int, error) {\n53\t\tkids, err := s.Children(parent)\n54\t\tif err != nil {\n55\t\t\treturn 0, err\n56\t\t}\n57\t\treturn nextRosterRankOf(kids), nil\n58\t}\n59\t\n60\t// nextRosterRankOf is nextRosterRank for a caller that already holds the\n61\t// roster, so the only copy of the \"one past the highest\" rule lives here.\n62\tfunc nextRosterRankOf(kids []*store.Ticket) int {\n63\t\tmax := -1\n64\t\tfor _, k := range kids {\n65\t\t\tif k.RosterRank > max {\n66\t\t\t\tmax = k.RosterRank\n67\t\t\t}\n68\t\t}\n69\t\treturn max + 1\n70\t}\n71\t\n72\t// requireAdopted refuses before opening a store that does not exist yet.\n73\t//\n74\t// Without this the machine gets the wrong error entirely: sqlitestore.Open\n75\t// CREATES the database when the path is absent, so the verb proceeds\n76\t// against an empty store, Render emits a WORK.md the corpus does not\n77\t// match, and EditedIn reports every file as \"edited by hand\" — on a\n78\t// machine where nobody edited anything. Worse, the advice that refusal\n79\t// gives (\"they are build outputs; the store is the source\") is actively\n80\t// dangerous against an empty store: following it means deleting the\n81\t// corpus. Say what is actually true instead, and name the command.\n82\tfunc requireAdopted(dataDir string) error {\n83\t\tif _, err := os.Stat(migrate.OutputPath(dataDir)); err == nil {\n84\t\t\treturn nil\n85\t\t} else if !os.IsNotExist(err) {\n86\t\t\treturn fmt.Errorf(\"opening store: %w\", err)\n87\t\t}\n88\t\treturn errWithExit(1,\n89\t\t\t\"this machine has not adopted the store yet — no database at %s\\nrun `worklog adopt` to preview the adoption, then `worklog adopt --commit`\",\n90\t\t\tmigrate.OutputPath(dataDir))\n91\t}\n92\t\n93\t// storeSession is one write verb's open store handle plus the layout it\n94\t// renders into — the shared plumbing every ticket-shaped store-backed\n95\t// write verb (start/done/edit/pr/link/note/wait/add/import) opens once,\n96\t// mutates a *store.Ticket (or several) against, and commits. The\n97\t// task<sub> family (task_store.go) predates this helper and keeps its\n98\t// own inline version; not worth touching already-shipped, tested code\n99\t// to unify the ~15 lines of overlap.\n100\ttype storeSession struct {\n101\t\ts      store.Store\n102\t\tlayout projection.Layout\n103\t\twd     model.Workdir\n104\t}\n105\t\n106\t// openStoreForWrite opens the store and refuses up front if any\n107\t// projection under wd/devboard has been hand-edited since the last\n108\t// render — the M3b policy: refuse before mutating, never after, since a\n109\t// render destroys whatever a human typed by hand.\n110\tfunc openStoreForWrite(wd model.Workdir) (*storeSession, error) {\n111\t\tdataDir, err := storeDataDir()\n112\t\tif err != nil {\n113\t\t\treturn nil, err\n114\t\t}\n115\t\tif err := requireAdopted(dataDir); err != nil {\n116\t\t\treturn nil, err\n117\t\t}\n118\t\ts, err := sqlitestore.Open(migrate.OutputPath(dataDir))\n119\t\tif err != nil {\n120\t\t\treturn nil, fmt.Errorf(\"opening store: %w\", err)\n121\t\t}\n122\t\tlayout := projection.Layout{WorklogDir: wd.Root, DevboardDir: devboard.DataDir()}\n123\t\n124\t\tedited, err := projection.EditedIn(s, layout)\n125\t\tif err != nil {\n126\t\t\ts.Close()\n127\t\t\treturn nil, fmt.Errorf(\"checking projections: %w\", err)\n128\t\t}\n129\t\tif len(edited) > 0 {\n130\t\t\ts.Close()\n131\t\t\treturn nil, errWithExit(1,\n132\t\t\t\t\"refusing to write — these projections were edited by hand and a re-render would discard the changes:\\n  %s\\nreconcile them first (they are build outputs; the store is the source)\",\n133\t\t\t\tstrings.Join(edited, \"\\n  \"))\n134\t\t}\n135\t\treturn &storeSession{s: s, layout: layout, wd: wd}, nil\n136\t}\n137\t\n138\tfunc (ss *storeSession) close() { ss.s.Close() }\n139\t\n140\t// commit persists t and synchronously re-renders every projection plus\n141\t// INDEX.md, so the dashboard and session-start hook see the write before\n142\t// this process exits (contract criterion 3). Unlike the task<sub> family,\n143\t// which never touches an indexed field, these verbs can change\n144\t// title/section/repo/tags, so INDEX.md is regenerated every time.\n145\tfunc (ss *storeSession) commit(t *store.Ticket) error {\n146\t\tif err := ss.s.PutTicket(t); err != nil {\n147\t\t\treturn err\n148\t\t}\n149\t\treturn ss.render()\n150\t}\n151\t\n152\t// commitFeedback persists e and re-renders — FEEDBACK.md isn't one of\n153\t// INDEX.md's four sections (ticket/tag/repo/archive-month), so no\n154\t// reindex is needed here.\n155\tfunc (ss *storeSession) commitFeedback(e *store.FeedbackEntry) error {\n156\t\tif err := ss.s.PutFeedback(e); err != nil {\n157\t\t\treturn err\n158\t\t}\n159\t\treturn projection.RenderTo(ss.s, ss.layout)\n160\t}\n161\t\n162\tfunc (ss *storeSession) render() error {\n163\t\tif err := projection.RenderTo(ss.s, ss.layout); err != nil {\n164\t\t\treturn fmt.Errorf(\"rendering projections: %w\", err)\n165\t\t}\n166\t\tif _, err := reindex.Run(ss.wd, reindex.Inputs{}); err != nil {\n167\t\t\treturn fmt.Errorf(\"regenerating INDEX.md: %w\", err)\n168\t\t}\n169\t\treturn nil\n170\t}\n171\t\n172\t// ensureBoardTracked replicates the one create-if-missing devboard hook\n173\t// the legacy write surface had (devboard.OnStart — done/pr/link's hooks\n174\t// all no-op on a missing entry, matching devboard.Find's contract). A\n175\t// ticket that has never been on the board gets BoardTracked, its session\n176\t// (for the dashboard's resume button — dev-context documents this as\n177\t// automatic on start), branch, and repo path; an already-tracked ticket\n178\t// only gets its repo path self-healed, same as legacy. declaredRepo is\n179\t// the ticket's own canonical Repo, used only to resolve a filesystem\n180\t// root when RepoPath is empty or has gone away.\n181\tfunc ensureBoardTracked(t *store.Ticket, declaredRepo string) {\n182\t\tif t.BoardTracked {\n183\t\t\tif t.RepoPath == \"\" || !dirExists(t.RepoPath) {\n184\t\t\t\tif root := devboard.RepoRootFor(declaredRepo); root != \"\" {\n185\t\t\t\t\tt.RepoPath = root\n186\t\t\t\t}\n187\t\t\t}\n188\t\t\treturn\n189\t\t}\n190\t\tif !devboard.Enabled() {\n191\t\t\treturn // devboard is opt-in by dir presence; a first tracking is a no-op, not a create\n192\t\t}\n193\t\tt.BoardTracked = true\n194\t\tif s := os.Getenv(\"CLAUDE_CODE_SESSION_ID\"); s != \"\" {\n195\t\t\tt.Session = s\n196\t\t}\n197\t\tif b := devboard.GitBranch(); b != \"\" {\n198\t\t\tt.Branch = b\n199\t\t}\n200\t\tif root := devboard.RepoRootFor(declaredRepo); root != \"\" {\n201\t\t\tt.RepoPath = root\n202\t\t}\n203\t}\n204\t\n205\t// ensureParentBoardTracked replicates legacy's devboardSyncEpic, called on\n206\t// every child start/resume/done: a child's parent epic never goes through\n207\t// its own start (epics can't occupy ## Now), so nothing else ever\n208\t// board-tracks it. Without this, an epic's own file is never created and\n209\t// children with nowhere to nest never render. No-ops for a standalone\n210\t// ticket (t.ParentID == \"\") or if the parent lookup fails — a dangling\n211\t// ParentID is reported by the caller's own checks, not silently patched\n212\t// here.\n213\tfunc ensureParentBoardTracked(ss *storeSession, t *store.Ticket) error {\n214\t\tif t.ParentID == \"\" {\n215\t\t\treturn nil\n216\t\t}\n217\t\tparent, err := ss.s.Ticket(t.ParentID)\n218\t\tif err != nil {\n219\t\t\treturn nil\n220\t\t}\n221\t\tensureBoardTracked(parent, parent.Repo)\n222\t\treturn ss.s.PutTicket(parent)\n223\t}\n224\t\n225\t// clearBoardTracked is untrack's store-side half. Render only ever writes\n226\t// the files it expects (every BoardTracked, non-child ticket); it never\n227\t// prunes a file that fell out of that set, so deleting a task file alone\n228\t// would leave it recreated on the next write that happens to re-render.\n229\t// No-op (not an error) when id doesn't resolve to a store ticket — a bare\n230\t// producer file (no worklog: join key) has nothing in the store to clear,\n231\t// and the caller deletes the file directly in that case.\n232\tfunc clearBoardTracked(wd model.Workdir, id string) error {\n233\t\tss, err := openStoreForWrite(wd)\n234\t\tif err != nil {\n235\t\t\treturn err\n236\t\t}\n237\t\tdefer ss.close()\n238\t\tt, err := ss.s.TicketBySlug(id)\n239\t\tif store.IsNotFound(err) {\n240\t\t\treturn nil\n241\t\t}\n242\t\tif err != nil {\n243\t\t\treturn err\n244\t\t}\n245\t\tt.BoardTracked = false\n246\t\treturn ss.commit(t)\n247\t}\n248\t\n249\tfunc dirExists(p string) bool {\n250\t\tif p == \"\" {\n251\t\t\treturn false\n252\t\t}\n253\t\tfi, err := os.Stat(p)\n254\t\treturn err == nil && fi.IsDir()\n255\t}\n256\t\n257\t// ticketBySlugOrErr resolves slug to a *store.Ticket, mapping a\n258\t// not-found lookup to notFoundErr (typically a package's own\n259\t// ErrIDNotFound sentinel) so callers keep their existing error-mapping\n260\t// switch statements unchanged between the legacy and store paths.\n261\tfunc (ss *storeSession) ticketBySlugOrErr(slug string, notFoundErr error) (*store.Ticket, error) {\n262\t\tt, err := ss.s.TicketBySlug(slug)\n263\t\tif store.IsNotFound(err) {\n264\t\t\treturn nil, fmt.Errorf(\"%w: %q\", notFoundErr, slug)\n265\t\t}\n266\t\tif err != nil {\n267\t\t\treturn nil, err\n268\t\t}\n269\t\treturn t, nil\n270\t}\n271\t"}]},"parent_tool_use_id":null,"session_id":"17dc1d64-f036-40f4-b7b4-ba080dcec9e5","uuid":"9a77fe3c-326d-4b31-a3a9-55bd83be2cc1","timestamp":"2026-09-08T06:40:26.383Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tmp.XPzs939dDg/ai-devboard/worklog/internal/cli/store_common.go","content":"package cli\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n\n\t\"github.com/prestontallen/ai-devboard/worklog/internal/devboard\"\n\t\"github.com/prestontallen/ai-devboard/worklog/internal/migrate\"\n\t\"github.com/prestontallen/ai-devboard/worklog/internal/model\"\n\t\"github.com/prestontallen/ai-devboard/worklog/internal/projection\"\n\t\"github.com/prestontallen/ai-devboard/worklog/internal/reindex\"\n\t\"github.com/prestontallen/ai-devboard/worklog/internal/store\"\n\t\"github.com/prestontallen/ai-devboard/worklog/internal/store/sqlitestore\"\n)\n\n// nextRank is the Rank a newly created ticket must carry: one past the\n// highest rank among live tickets, so it renders at the END of its\n// section.\n//\n// Leaving it at the zero value is not \"unranked\" — it is the literal\n// rank of whichever ticket sits first in WORK.md, because convert\n// numbers document position from zero (convert/workmd.go:73). A new\n// ticket defaulting to 0 therefore *ties* the first ticket, and\n// Tickets() breaks that tie with `ORDER BY rank, slug` — so the new\n// ticket silently sorts by alphabetical luck instead of landing where\n// the human put it. Observed live: a ticket added on 2026-09-03 tied\n// adb-research-mode at rank 0 and won the slug comparison, jumping to\n// the top of ## Now.\n//\n// Archived tickets are excluded: their Rank is a position within an\n// archive month, a different numbering space that says nothing about\n// where a live ticket belongs.\nfunc nextRank(s store.Store) (int, error) {\n\ttickets, err := s.Tickets()\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tmax := -1\n\tfor _, t := range tickets {\n\t\tif !t.Archived && t.Rank > max {\n\t\t\tmax = t.Rank\n\t\t}\n\t}\n\treturn max + 1, nil\n}\n\n// nextRosterRank is nextRank for an epic's child roster. Same collision,\n// one level down: RosterRank is assigned only by convert (convert.go:161,\n// :181), so a child added through the CLI defaults to 0, ties the epic's\n// first child, and is ordered against it by slug.\nfunc nextRosterRank(s store.Store, parent store.ID) (int, error) {\n\tkids, err := s.Children(parent)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn nextRosterRankOf(kids), nil\n}\n\n// nextRosterRankOf is nextRosterRank for a caller that already holds the\n// roster, so the only copy of the \"one past the highest\" rule lives here.\nfunc nextRosterRankOf(kids []*store.Ticket) int {\n\tmax := -1\n\tfor _, k := range kids {\n\t\tif k.RosterRank > max {\n\t\t\tmax = k.RosterRank\n\t\t}\n\t}\n\treturn max + 1\n}\n\n// requireAdopted refuses before opening a store that does not exist yet.\n//\n// Without this the machine gets the wrong error entirely: sqlitestore.Open\n// CREATES the database when the path is absent, so the verb proceeds\n// against an empty store, Render emits a WORK.md the corpus does not\n// match, and EditedIn reports every file as \"edited by hand\" — on a\n// machine where nobody edited anything. Worse, the advice that refusal\n// gives (\"they are build outputs; the store is the source\") is actively\n// dangerous against an empty store: following it means deleting the\n// corpus. Say what is actually true instead, and name the command.\nfunc requireAdopted(dataDir string) error {\n\tif _, err := os.Stat(migrate.OutputPath(dataDir)); err == nil {\n\t\treturn nil\n\t} else if !os.IsNotExist(err) {\n\t\treturn fmt.Errorf(\"opening store: %w\", err)\n\t}\n\treturn errWithExit(1,\n\t\t\"this machine has not adopted the store yet — no database at %s\\nrun `worklog adopt` to preview the adoption, then `worklog adopt --commit`\",\n\t\tmigrate.OutputPath(dataDir))\n}\n\n// storeSession is one write verb's open store handle plus the layout it\n// renders into — the shared plumbing every ticket-shaped store-backed\n// write verb (start/done/edit/pr/link/note/wait/add/import) opens once,\n// mutates a *store.Ticket (or several) against, and commits. The\n// task<sub> family (task_store.go) predates this helper and keeps its\n// own inline version; not worth touching already-shipped, tested code\n// to unify the ~15 lines of overlap.\ntype storeSession struct {\n\ts      store.Store\n\tlayout projection.Layout\n\twd     model.Workdir\n}\n\n// openStoreForWrite opens the store and refuses up front if any\n// projection under wd/devboard has been hand-edited since the last\n// render — the M3b policy: refuse before mutating, never after, since a\n// render destroys whatever a human typed by hand.\nfunc openStoreForWrite(wd model.Workdir) (*storeSession, error) {\n\tdataDir, err := storeDataDir()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tif err := requireAdopted(dataDir); err != nil {\n\t\treturn nil, err\n\t}\n\ts, err := sqlitestore.Open(migrate.OutputPath(dataDir))\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"opening store: %w\", err)\n\t}\n\tlayout := projection.Layout{WorklogDir: wd.Root, DevboardDir: devboard.DataDir()}\n\n\tedited, err := projection.EditedIn(s, layout)\n\tif err != nil {\n\t\ts.Close()\n\t\treturn nil, fmt.Errorf(\"checking projections: %w\", err)\n\t}\n\tif len(edited) > 0 {\n\t\ts.Close()\n\t\treturn nil, errWithExit(1,\n\t\t\t\"refusing to write — these projections were edited by hand and a re-render would discard the changes:\\n  %s\\nreconcile them first (they are build outputs; the store is the source)\",\n\t\t\tstrings.Join(edited, \"\\n  \"))\n\t}\n\treturn &storeSession{s: s, layout: layout, wd: wd}, nil\n}\n\nfunc (ss *storeSession) close() { ss.s.Close() }\n\n// commit persists t and synchronously re-renders every projection plus\n// INDEX.md, so the dashboard and session-start hook see the write before\n// this process exits (contract criterion 3). Unlike the task<sub> family,\n// which never touches an indexed field, these verbs can change\n// title/section/repo/tags, so INDEX.md is regenerated every time.\nfunc (ss *storeSession) commit(t *store.Ticket) error {\n\tif err := ss.s.PutTicket(t); err != nil {\n\t\treturn err\n\t}\n\treturn ss.render()\n}\n\n// commitFeedback persists e and re-renders — FEEDBACK.md isn't one of\n// INDEX.md's four sections (ticket/tag/repo/archive-month), so no\n// reindex is needed here.\nfunc (ss *storeSession) commitFeedback(e *store.FeedbackEntry) error {\n\tif err := ss.s.PutFeedback(e); err != nil {\n\t\treturn err\n\t}\n\treturn projection.RenderTo(ss.s, ss.layout)\n}\n\nfunc (ss *storeSession) render() error {\n\tif err := projection.RenderTo(ss.s, ss.layout); err != nil {\n\t\treturn fmt.Errorf(\"rendering projections: %w\", err)\n\t}\n\tif _, err := reindex.Run(ss.wd, reindex.Inputs{}); err != nil {\n\t\treturn fmt.Errorf(\"regenerating INDEX.md: %w\", err)\n\t}\n\treturn nil\n}\n\n// ensureBoardTracked replicates the one create-if-missing devboard hook\n// the legacy write surface had (devboard.OnStart — done/pr/link's hooks\n// all no-op on a missing entry, matching devboard.Find's contract). A\n// ticket that has never been on the board gets BoardTracked, its session\n// (for the dashboard's resume button — dev-context documents this as\n// automatic on start), branch, and repo path; an already-tracked ticket\n// only gets its repo path self-healed, same as legacy. declaredRepo is\n// the ticket's own canonical Repo, used only to resolve a filesystem\n// root when RepoPath is empty or has gone away.\nfunc ensureBoardTracked(t *store.Ticket, declaredRepo string) {\n\tif t.BoardTracked {\n\t\tif t.RepoPath == \"\" || !dirExists(t.RepoPath) {\n\t\t\tif root := devboard.RepoRootFor(declaredRepo); root != \"\" {\n\t\t\t\tt.RepoPath = root\n\t\t\t}\n\t\t}\n\t\treturn\n\t}\n\tif !devboard.Enabled() {\n\t\treturn // devboard is opt-in by dir presence; a first tracking is a no-op, not a create\n\t}\n\tt.BoardTracked = true\n\tif s := os.Getenv(\"CLAUDE_CODE_SESSION_ID\"); s != \"\" {\n\t\tt.Session = s\n\t}\n\tif b := devboard.GitBranch(); b != \"\" {\n\t\tt.Branch = b\n\t}\n\tif root := devboard.RepoRootFor(declaredRepo); root != \"\" {\n\t\tt.RepoPath = root\n\t}\n}\n\n// ensureParentBoardTracked replicates legacy's devboardSyncEpic, called on\n// every child start/resume/done: a child's parent epic never goes through\n// its own start (epics can't occupy ## Now), so nothing else ever\n// board-tracks it. Without this, an epic's own file is never created and\n// children with nowhere to nest never render. No-ops for a standalone\n// ticket (t.ParentID == \"\") or if the parent lookup fails — a dangling\n// ParentID is reported by the caller's own checks, not silently patched\n// here.\nfunc ensureParentBoardTracked(ss *storeSession, t *store.Ticket) error {\n\tif t.ParentID == \"\" {\n\t\treturn nil\n\t}\n\tparent, err := ss.s.Ticket(t.ParentID)\n\tif err != nil {\n\t\treturn nil\n\t}\n\tensureBoardTracked(parent, parent.Repo)\n\treturn ss.s.PutTicket(parent)\n}\n\n// clearBoardTracked is untrack's store-side half. Render only ever writes\n// the files it expects (every BoardTracked, non-child ticket); it never\n// prunes a file that fell out of that set, so deleting a task file alone\n// would leave it recreated on the next write that happens to re-render.\n// No-op (not an error) when id doesn't resolve to a store ticket — a bare\n// producer file (no worklog: join key) has nothing in the store to clear,\n// and the caller deletes the file directly in that case.\nfunc clearBoardTracked(wd model.Workdir, id string) error {\n\tss, err := openStoreForWrite(wd)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer ss.close()\n\tt, err := ss.s.TicketBySlug(id)\n\tif store.IsNotFound(err) {\n\t\treturn nil\n\t}\n\tif err != nil {\n\t\treturn err\n\t}\n\tt.BoardTracked = false\n\treturn ss.commit(t)\n}\n\nfunc dirExists(p string) bool {\n\tif p == \"\" {\n\t\treturn false\n\t}\n\tfi, err := os.Stat(p)\n\treturn err == nil && fi.IsDir()\n}\n\n// ticketBySlugOrErr resolves slug to a *store.Ticket, mapping a\n// not-found lookup to notFoundErr (typically a package's own\n// ErrIDNotFound sentinel) so callers keep their existing error-mapping\n// switch statements unchanged between the legacy and store paths.\nfunc (ss *storeSession) ticketBySlugOrErr(slug string, notFoundErr error) (*store.Ticket, error) {\n\tt, err := ss.s.TicketBySlug(slug)\n\tif store.IsNotFound(err) {\n\t\treturn nil, fmt.Errorf(\"%w: %q\", notFoundErr, slug)\n\t}\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn t, nil\n}\n","numLines":271,"startLine":1,"totalLines":271}}}
{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_011CeqWozZj9kJNvBEhMztth","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XBwrgGrjbBpya5BVtpPiMw","name":"Read","input":{"file_path":"/tmp/tmp.XPzs939dDg/ai-devboard/worklog/internal/projection/projection.go"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4761,"cache_read_input_tokens":19403,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4761},"output_tokens":20,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"17dc1d64-f036-40f4-b7b4-ba080dcec9e5","uuid":"7f57a7bf-a319-4e2b-a5eb-b46adf200f61","timestamp":"2026-09-08T06:40:26.594Z","request_id":"req_011CeqWowvirhUNspWjg2AXn"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XBwrgGrjbBpya5BVtpPiMw","type":"tool_result","content":"1\t// Package projection renders the markdown and YAML surfaces from a Store.\n2\t// Projections are read-only build outputs: banner-stamped where the format\n3\t// allows, regenerated write-through, and compared before writing so a\n4\t// byte-identical render never touches mtime (the frozen SSE behavior must\n5\t// not fire on no-op rebuilds).\n6\tpackage projection\n7\t\n8\timport (\n9\t\t\"bytes\"\n10\t\t\"fmt\"\n11\t\t\"os\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/prestontallen/ai-devboard/worklog/internal/model\"\n17\t\t\"github.com/prestontallen/ai-devboard/worklog/internal/store\"\n18\t)\n19\t\n20\t// Banner is the build-output marker emitted at the top of the markdown\n21\t// surfaces. It lives in internal/model so the parser can strip it without\n22\t// depending on this package (see model.Banner).\n23\tconst Banner = model.Banner\n24\t\n25\tfunc banner(b *bytes.Buffer) { b.WriteString(Banner + \"\\n\") }\n26\t\n27\t// Render produces every projection of s as an in-memory map of\n28\t// slash-separated relative path to content: WORK.md, notes/<slug>.md,\n29\t// archive/<month>.md, FEEDBACK.md, devboard/<repo>/<slug>.yaml (with\n30\t// _archive/ for board-archived tasks).\n31\t//\n32\t// INDEX.md is deliberately absent: it is produced by running the real\n33\t// reindex over this output, so the projection IS that code's output\n34\t// rather than a reimplementation of it.\n35\tfunc Render(s store.Store) (map[string][]byte, error) {\n36\t\ttickets, err := s.Tickets()\n37\t\tif err != nil {\n38\t\t\treturn nil, err\n39\t\t}\n40\t\tout := map[string][]byte{\"WORK.md\": WorkMD(tickets)}\n41\t\n42\t\tfor _, t := range tickets {\n43\t\t\tif t.NotesPreamble == \"\" && len(t.NoteEntries) == 0 {\n44\t\t\t\tcontinue\n45\t\t\t}\n46\t\t\tif t.Slug == \"\" {\n47\t\t\t\tcontinue // slug-less quick-capture entities carry no notes file\n48\t\t\t}\n49\t\t\tout[\"notes/\"+t.Slug+\".md\"] = NotesFile(t)\n50\t\t}\n51\t\n52\t\tmonths := map[string][]*store.Ticket{}\n53\t\tfor _, t := range tickets {\n54\t\t\tif t.Archived && t.ArchiveMonth != \"\" {\n55\t\t\t\tmonths[t.ArchiveMonth] = append(months[t.ArchiveMonth], t)\n56\t\t\t}\n57\t\t}\n58\t\tfor month, ts := range months {\n59\t\t\tout[\"archive/\"+month+\".md\"] = ArchiveMonth(month, ts, tickets)\n60\t\t}\n61\t\n62\t\tfb, err := s.Feedback()\n63\t\tif err != nil {\n64\t\t\treturn nil, err\n65\t\t}\n66\t\t// Always emitted, even with zero entries. Gating on len(fb) made\n67\t\t// FEEDBACK.md invisible to BOTH EditedIn and RenderTo whenever the\n68\t\t// store happened to hold no feedback — so a hand-edited or\n69\t\t// merely-unread friction log was neither protected from a re-render\n70\t\t// nor rewritten by one, until the first entry arrived and replaced it\n71\t\t// wholesale. A projection's existence is a property of the surface,\n72\t\t// not of its row count.\n73\t\tout[\"FEEDBACK.md\"] = FeedbackMD(fb)\n74\t\n75\t\tfor _, t := range tickets {\n76\t\t\tif !t.BoardTracked || t.ParentID != \"\" {\n77\t\t\t\tcontinue // children render inside their epic's file\n78\t\t\t}\n79\t\t\tkids, err := s.Children(t.ID)\n80\t\t\tif err != nil {\n81\t\t\t\treturn nil, err\n82\t\t\t}\n83\t\t\t// A child never gets its own top-level file (see the skip above),\n84\t\t\t// so its own BoardTracked flag doesn't gate anything here — the\n85\t\t\t// epic's roster is the only surface a child ever appears on, and\n86\t\t\t// it's the full history: pending, active, and done children alike\n87\t\t\t// (a done child leaves ## Now but stays on the epic's card as\n88\t\t\t// completed history until the epic itself is archived).\n89\t\t\t// Repo attribution heals here (ratified OQ2): the canonical repo\n90\t\t\t// field decides the group directory, never the writer's cwd.\n91\t\t\trepo := t.Repo\n92\t\t\tif repo == \"\" {\n93\t\t\t\trepo = \"unknown\"\n94\t\t\t}\n95\t\t\tdir := \"devboard/\" + repo\n96\t\t\tif t.BoardArchived {\n97\t\t\t\tdir += \"/_archive\"\n98\t\t\t}\n99\t\t\tout[dir+\"/\"+t.Slug+\".yaml\"] = BoardYAML(t, kids)\n100\t\t}\n101\t\treturn out, nil\n102\t}\n103\t\n104\t// Layout locates the two directories the projections actually split\n105\t// across in a live install: the worklog dir (WORK.md, notes/, archive/,\n106\t// FEEDBACK.md) and the devboard dir, which is a sibling rather than a\n107\t// subdirectory. Render's map is rooted at a single tree, so this is where\n108\t// the \"devboard/\" prefix gets redirected.\n109\ttype Layout struct {\n110\t\tWorklogDir  string\n111\t\tDevboardDir string\n112\t}\n113\t\n114\t// SingleRoot is the layout the staged copies and tests use, where the\n115\t// devboard tree sits under the worklog root as Render names it.\n116\tfunc SingleRoot(root string) Layout {\n117\t\treturn Layout{WorklogDir: root, DevboardDir: filepath.Join(root, \"devboard\")}\n118\t}\n119\t\n120\tfunc (l Layout) path(rel string) string {\n121\t\tif after, ok := strings.CutPrefix(rel, \"devboard/\"); ok {\n122\t\t\treturn filepath.Join(l.DevboardDir, filepath.FromSlash(after))\n123\t\t}\n124\t\treturn filepath.Join(l.WorklogDir, filepath.FromSlash(rel))\n125\t}\n126\t\n127\t// RenderTo writes every projection of s into the two directories l names.\n128\tfunc RenderTo(s store.Store, l Layout) error {\n129\t\tfiles, err := Render(s)\n130\t\tif err != nil {\n131\t\t\treturn err\n132\t\t}\n133\t\tfor rel, content := range files {\n134\t\t\tif err := writeIfChanged(l.path(rel), content); err != nil {\n135\t\t\t\treturn err\n136\t\t\t}\n137\t\t\t// The store owns where a board task file lives, so archiving is a\n138\t\t\t// re-render rather than a rename (adb-archive-store-desync). Clearing\n139\t\t\t// the path the ticket just left is the other half of that: without it\n140\t\t\t// the board shows one task twice, once per path.\n141\t\t\tif sib := boardSibling(rel); sib != \"\" {\n142\t\t\t\tif err := os.Remove(l.path(sib)); err != nil && !os.IsNotExist(err) {\n143\t\t\t\t\treturn fmt.Errorf(\"clearing %s: %w\", sib, err)\n144\t\t\t\t}\n145\t\t\t}\n146\t\t}\n147\t\treturn nil\n148\t}\n149\t\n150\t// archiveSegment is the directory an archived board task file lives in,\n151\t// relative to its repo dir.\n152\tconst archiveSegment = \"_archive\"\n153\t\n154\t/*\n155\tboardSibling returns the other place THIS rendered board task file could\n156\tlegitimately live — live <-> _archive — or \"\" for anything that is not one.\n157\t\n158\tThe narrowness is the whole safety argument. Render only removes the sibling\n159\tof a path it just wrote, and it only writes files for board-tracked tickets\n160\tin the store, so a file the store has no ticket for can never be named here.\n161\tThat is what keeps hand-dropped producer files — a supported input per\n162\tdevboard/README.md, and present in the live corpus — out of reach. The broad\n163\trule (\"delete anything I did not render\") would take every one of them.\n164\t*/\n165\tfunc boardSibling(rel string) string {\n166\t\tif !strings.HasPrefix(rel, \"devboard/\") || !strings.HasSuffix(rel, \".yaml\") {\n167\t\t\treturn \"\"\n168\t\t}\n169\t\tdir, file := filepath.Split(rel)\n170\t\tdir = strings.TrimSuffix(dir, \"/\")\n171\t\tif filepath.Base(dir) == archiveSegment {\n172\t\t\treturn filepath.Dir(dir) + \"/\" + file\n173\t\t}\n174\t\treturn dir + \"/\" + archiveSegment + \"/\" + file\n175\t}\n176\t\n177\t// RenderAll writes every projection of s under a single root.\n178\tfunc RenderAll(s store.Store, root string) error { return RenderTo(s, SingleRoot(root)) }\n179\t\n180\t// EditedFiles reports the projections under root whose bytes differ from\n181\t// what s renders right now, newline-sorted — the files someone hand-edited\n182\t// since the last write, whose content a re-render would destroy.\n183\t//\n184\t// It only inspects paths the store actually renders, so files it does not\n185\t// own are never flagged: bare devboard producer files (which are not\n186\t// canon), INDEX.md, and anything else living alongside. A rendered file\n187\t// missing from disk counts as edited; it was deleted.\n188\tfunc EditedFiles(s store.Store, root string) ([]string, error) {\n189\t\treturn EditedIn(s, SingleRoot(root))\n190\t}\n191\t\n192\t// EditedIn is EditedFiles against a two-directory live layout.\n193\tfunc EditedIn(s store.Store, l Layout) ([]string, error) {\n194\t\tfiles, err := Render(s)\n195\t\tif err != nil {\n196\t\t\treturn nil, err\n197\t\t}\n198\t\tvar edited []string\n199\t\tfor rel, want := range files {\n200\t\t\tgot, err := os.ReadFile(l.path(rel))\n201\t\t\tif os.IsNotExist(err) {\n202\t\t\t\t// Absent is usually a deletion, and a deletion is an edit. The one\n203\t\t\t\t// exception is a board task file that is byte-identical at its\n204\t\t\t\t// sibling path: that is a move the store did not record, not\n205\t\t\t\t// something someone wrote (adb-archive-store-desync). Refusing it\n206\t\t\t\t// meant a single board click blocked every later write, with a\n207\t\t\t\t// message about hand-editing that named a state the board itself\n208\t\t\t\t// created. Anything whose bytes differ is still an edit.\n209\t\t\t\tif !movedIntact(l, rel, want) {\n210\t\t\t\t\tedited = append(edited, rel)\n211\t\t\t\t}\n212\t\t\t\tcontinue\n213\t\t\t}\n214\t\t\tif err != nil {\n215\t\t\t\treturn nil, err\n216\t\t\t}\n217\t\t\tif !bytes.Equal(got, want) {\n218\t\t\t\tedited = append(edited, rel)\n219\t\t\t}\n220\t\t}\n221\t\tsort.Strings(edited)\n222\t\treturn edited, nil\n223\t}\n224\t\n225\t// movedIntact reports whether a rendered board file is missing from its own\n226\t// path only because it sits, byte for byte, at the other one. The next render\n227\t// puts it back where the store says it belongs and clears the sibling, so\n228\t// there is nothing to lose by proceeding — which is exactly what makes this\n229\t// safe to wave through and a differing copy not.\n230\tfunc movedIntact(l Layout, rel string, want []byte) bool {\n231\t\tsib := boardSibling(rel)\n232\t\tif sib == \"\" {\n233\t\t\treturn false\n234\t\t}\n235\t\tgot, err := os.ReadFile(l.path(sib))\n236\t\treturn err == nil && bytes.Equal(got, want)\n237\t}\n238\t\n239\t// writeIfChanged is the freshness rule (criterion 13): identical content\n240\t// never rewrites the file, so watchers see no phantom change.\n241\tfunc writeIfChanged(path string, content []byte) error {\n242\t\tif old, err := os.ReadFile(path); err == nil && bytes.Equal(old, content) {\n243\t\t\treturn nil\n244\t\t}\n245\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n246\t\t\treturn err\n247\t\t}\n248\t\ttmp, err := os.CreateTemp(filepath.Dir(path), \".proj-*\")\n249\t\tif err != nil {\n250\t\t\treturn err\n251\t\t}\n252\t\tif _, err := tmp.Write(content); err != nil {\n253\t\t\ttmp.Close()\n254\t\t\tos.Remove(tmp.Name())\n255\t\t\treturn err\n256\t\t}\n257\t\tif err := tmp.Close(); err != nil {\n258\t\t\tos.Remove(tmp.Name())\n259\t\t\treturn err\n260\t\t}\n261\t\treturn os.Rename(tmp.Name(), path)\n262\t}\n263\t\n264\t// FeedbackMD renders the friction log in the exact format\n265\t// internal/feedback writes and parses.\n266\tfunc FeedbackMD(entries []*store.FeedbackEntry) []byte {\n267\t\tvar b bytes.Buffer\n268\t\tb.WriteString(\"# Worklog Feedback Log\\n\")\n269\t\tfor _, e := range entries {\n270\t\t\tfmt.Fprintf(&b, \"\\n## %d — %s\\n\", e.Seconds, e.Signal)\n271\t\t\tfmt.Fprintf(&b, \"**Trigger**: %s\\n\", e.Trigger)\n272\t\t\tif e.Excerpt != \"\" {\n273\t\t\t\tb.WriteString(\"**Excerpt**:\\n\")\n274\t\t\t\tfor _, line := range splitLines(e.Excerpt) {\n275\t\t\t\t\tfmt.Fprintf(&b, \"> %s\\n\", line)\n276\t\t\t\t}\n277\t\t\t}\n278\t\t\tif e.Context != \"\" {\n279\t\t\t\tfmt.Fprintf(&b, \"**Context**: %s\\n\", e.Context)\n280\t\t\t}\n281\t\t\tif e.Resolved != 0 {\n282\t\t\t\tfmt.Fprintf(&b, \"**Resolved**: %d\\n\", e.Resolved)\n283\t\t\t}\n284\t\t}\n285\t\treturn b.Bytes()\n286\t}\n287\t\n288\tfunc splitLines(s string) []string {\n289\t\tvar out []string\n290\t\tstart := 0\n291\t\tfor i := 0; i < len(s); i++ {\n292\t\t\tif s[i] == '\\n' {\n293\t\t\t\tout = append(out, s[start:i])\n294\t\t\t\tstart = i + 1\n295\t\t\t}\n296\t\t}\n297\t\treturn append(out, s[start:])\n298\t}\n299\t\n300\tfunc sortedKeys[V any](m map[string]V) []string {\n301\t\tout := make([]string, 0, len(m))\n302\t\tfor k := range m {\n303\t\t\tout = append(out, k)\n304\t\t}\n305\t\tsort.Strings(out)\n306\t\treturn out\n307\t}\n308\t"}]},"parent_tool_use_id":null,"session_id":"17dc1d64-f036-40f4-b7b4-ba080dcec9e5","uuid":"3c3323f6-e558-4685-9f61-b38c1d0fb706","timestamp":"2026-09-08T06:40:26.598Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tmp.XPzs939dDg/ai-devboard/worklog/internal/projection/projection.go","content":"// Package projection renders the markdown and YAML surfaces from a Store.\n// Projections are read-only build outputs: banner-stamped where the format\n// allows, regenerated write-through, and compared before writing so a\n// byte-identical render never touches mtime (the frozen SSE behavior must\n// not fire on no-op rebuilds).\npackage projection\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/prestontallen/ai-devboard/worklog/internal/model\"\n\t\"github.com/prestontallen/ai-devboard/worklog/internal/store\"\n)\n\n// Banner is the build-output marker emitted at the top of the markdown\n// surfaces. It lives in internal/model so the parser can strip it without\n// depending on this package (see model.Banner).\nconst Banner = model.Banner\n\nfunc banner(b *bytes.Buffer) { b.WriteString(Banner + \"\\n\") }\n\n// Render produces every projection of s as an in-memory map of\n// slash-separated relative path to content: WORK.md, notes/<slug>.md,\n// archive/<month>.md, FEEDBACK.md, devboard/<repo>/<slug>.yaml (with\n// _archive/ for board-archived tasks).\n//\n// INDEX.md is deliberately absent: it is produced by running the real\n// reindex over this output, so the projection IS that code's output\n// rather than a reimplementation of it.\nfunc Render(s store.Store) (map[string][]byte, error) {\n\ttickets, err := s.Tickets()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tout := map[string][]byte{\"WORK.md\": WorkMD(tickets)}\n\n\tfor _, t := range tickets {\n\t\tif t.NotesPreamble == \"\" && len(t.NoteEntries) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tif t.Slug == \"\" {\n\t\t\tcontinue // slug-less quick-capture entities carry no notes file\n\t\t}\n\t\tout[\"notes/\"+t.Slug+\".md\"] = NotesFile(t)\n\t}\n\n\tmonths := map[string][]*store.Ticket{}\n\tfor _, t := range tickets {\n\t\tif t.Archived && t.ArchiveMonth != \"\" {\n\t\t\tmonths[t.ArchiveMonth] = append(months[t.ArchiveMonth], t)\n\t\t}\n\t}\n\tfor month, ts := range months {\n\t\tout[\"archive/\"+month+\".md\"] = ArchiveMonth(month, ts, tickets)\n\t}\n\n\tfb, err := s.Feedback()\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\t// Always emitted, even with zero entries. Gating on len(fb) made\n\t// FEEDBACK.md invisible to BOTH EditedIn and RenderTo whenever the\n\t// store happened to hold no feedback — so a hand-edited or\n\t// merely-unread friction log was neither protected from a re-render\n\t// nor rewritten by one, until the first entry arrived and replaced it\n\t// wholesale. A projection's existence is a property of the surface,\n\t// not of its row count.\n\tout[\"FEEDBACK.md\"] = FeedbackMD(fb)\n\n\tfor _, t := range tickets {\n\t\tif !t.BoardTracked || t.ParentID != \"\" {\n\t\t\tcontinue // children render inside their epic's file\n\t\t}\n\t\tkids, err := s.Children(t.ID)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\t// A child never gets its own top-level file (see the skip above),\n\t\t// so its own BoardTracked flag doesn't gate anything here — the\n\t\t// epic's roster is the only surface a child ever appears on, and\n\t\t// it's the full history: pending, active, and done children alike\n\t\t// (a done child leaves ## Now but stays on the epic's card as\n\t\t// completed history until the epic itself is archived).\n\t\t// Repo attribution heals here (ratified OQ2): the canonical repo\n\t\t// field decides the group directory, never the writer's cwd.\n\t\trepo := t.Repo\n\t\tif repo == \"\" {\n\t\t\trepo = \"unknown\"\n\t\t}\n\t\tdir := \"devboard/\" + repo\n\t\tif t.BoardArchived {\n\t\t\tdir += \"/_archive\"\n\t\t}\n\t\tout[dir+\"/\"+t.Slug+\".yaml\"] = BoardYAML(t, kids)\n\t}\n\treturn out, nil\n}\n\n// Layout locates the two directories the projections actually split\n// across in a live install: the worklog dir (WORK.md, notes/, archive/,\n// FEEDBACK.md) and the devboard dir, which is a sibling rather than a\n// subdirectory. Render's map is rooted at a single tree, so this is where\n// the \"devboard/\" prefix gets redirected.\ntype Layout struct {\n\tWorklogDir  string\n\tDevboardDir string\n}\n\n// SingleRoot is the layout the staged copies and tests use, where the\n// devboard tree sits under the worklog root as Render names it.\nfunc SingleRoot(root string) Layout {\n\treturn Layout{WorklogDir: root, DevboardDir: filepath.Join(root, \"devboard\")}\n}\n\nfunc (l Layout) path(rel string) string {\n\tif after, ok := strings.CutPrefix(rel, \"devboard/\"); ok {\n\t\treturn filepath.Join(l.DevboardDir, filepath.FromSlash(after))\n\t}\n\treturn filepath.Join(l.WorklogDir, filepath.FromSlash(rel))\n}\n\n// RenderTo writes every projection of s into the two directories l names.\nfunc RenderTo(s store.Store, l Layout) error {\n\tfiles, err := Render(s)\n\tif err != nil {\n\t\treturn err\n\t}\n\tfor rel, content := range files {\n\t\tif err := writeIfChanged(l.path(rel), content); err != nil {\n\t\t\treturn err\n\t\t}\n\t\t// The store owns where a board task file lives, so archiving is a\n\t\t// re-render rather than a rename (adb-archive-store-desync). Clearing\n\t\t// the path the ticket just left is the other half of that: without it\n\t\t// the board shows one task twice, once per path.\n\t\tif sib := boardSibling(rel); sib != \"\" {\n\t\t\tif err := os.Remove(l.path(sib)); err != nil && !os.IsNotExist(err) {\n\t\t\t\treturn fmt.Errorf(\"clearing %s: %w\", sib, err)\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\n// archiveSegment is the directory an archived board task file lives in,\n// relative to its repo dir.\nconst archiveSegment = \"_archive\"\n\n/*\nboardSibling returns the other place THIS rendered board task file could\nlegitimately live — live <-> _archive — or \"\" for anything that is not one.\n\nThe narrowness is the whole safety argument. Render only removes the sibling\nof a path it just wrote, and it only writes files for board-tracked tickets\nin the store, so a file the store has no ticket for can never be named here.\nThat is what keeps hand-dropped producer files — a supported input per\ndevboard/README.md, and present in the live corpus — out of reach. The broad\nrule (\"delete anything I did not render\") would take every one of them.\n*/\nfunc boardSibling(rel string) string {\n\tif !strings.HasPrefix(rel, \"devboard/\") || !strings.HasSuffix(rel, \".yaml\") {\n\t\treturn \"\"\n\t}\n\tdir, file := filepath.Split(rel)\n\tdir = strings.TrimSuffix(dir, \"/\")\n\tif filepath.Base(dir) == archiveSegment {\n\t\treturn filepath.Dir(dir) + \"/\" + file\n\t}\n\treturn dir + \"/\" + archiveSegment + \"/\" + file\n}\n\n// RenderAll writes every projection of s under a single root.\nfunc RenderAll(s store.Store, root string) error { return RenderTo(s, SingleRoot(root)) }\n\n// EditedFiles reports the projections under root whose bytes differ from\n// what s renders right now, newline-sorted — the files someone hand-edited\n// since the last write, whose content a re-render would destroy.\n//\n// It only inspects paths the store actually renders, so files it does not\n// own are never flagged: bare devboard producer files (which are not\n// canon), INDEX.md, and anything else living alongside. A rendered file\n// missing from disk counts as edited; it was deleted.\nfunc EditedFiles(s store.Store, root string) ([]string, error) {\n\treturn EditedIn(s, SingleRoot(root))\n}\n\n// EditedIn is EditedFiles against a two-directory live layout.\nfunc EditedIn(s store.Store, l Layout) ([]string, error) {\n\tfiles, err := Render(s)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar edited []string\n\tfor rel, want := range files {\n\t\tgot, err := os.ReadFile(l.path(rel))\n\t\tif os.IsNotExist(err) {\n\t\t\t// Absent is usually a deletion, and a deletion is an edit. The one\n\t\t\t// exception is a board task file that is byte-identical at its\n\t\t\t// sibling path: that is a move the store did not record, not\n\t\t\t// something someone wrote (adb-archive-store-desync). Refusing it\n\t\t\t// meant a single board click blocked every later write, with a\n\t\t\t// message about hand-editing that named a state the board itself\n\t\t\t// created. Anything whose bytes differ is still an edit.\n\t\t\tif !movedIntact(l, rel, want) {\n\t\t\t\tedited = append(edited, rel)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif !bytes.Equal(got, want) {\n\t\t\tedited = append(edited, rel)\n\t\t}\n\t}\n\tsort.Strings(edited)\n\treturn edited, nil\n}\n\n// movedIntact reports whether a rendered board file is missing from its own\n// path only because it sits, byte for byte, at the other one. The next render\n// puts it back where the store says it belongs and clears the sibling, so\n// there is nothing to lose by proceeding — which is exactly what makes this\n// safe to wave through and a differing copy not.\nfunc movedIntact(l Layout, rel string, want []byte) bool {\n\tsib := boardSibling(rel)\n\tif sib == \"\" {\n\t\treturn false\n\t}\n\tgot, err := os.ReadFile(l.path(sib))\n\treturn err == nil && bytes.Equal(got, want)\n}\n\n// writeIfChanged is the freshness rule (criterion 13): identical content\n// never rewrites the file, so watchers see no phantom change.\nfunc writeIfChanged(path string, content []byte) error {\n\tif old, err := os.ReadFile(path); err == nil && bytes.Equal(old, content) {\n\t\treturn nil\n\t}\n\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n\t\treturn err\n\t}\n\ttmp, err := os.CreateTemp(filepath.Dir(path), \".proj-*\")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif _, err := tmp.Write(content); err != nil {\n\t\ttmp.Close()\n\t\tos.Remove(tmp.Name())\n\t\treturn err\n\t}\n\tif err := tmp.Close(); err != nil {\n\t\tos.Remove(tmp.Name())\n\t\treturn err\n\t}\n\treturn os.Rename(tmp.Name(), path)\n}\n\n// FeedbackMD renders the friction log in the exact format\n// internal/feedback writes and parses.\nfunc FeedbackMD(entries []*store.FeedbackEntry) []byte {\n\tvar b bytes.Buffer\n\tb.WriteString(\"# Worklog Feedback Log\\n\")\n\tfor _, e := range entries {\n\t\tfmt.Fprintf(&b, \"\\n## %d — %s\\n\", e.Seconds, e.Signal)\n\t\tfmt.Fprintf(&b, \"**Trigger**: %s\\n\", e.Trigger)\n\t\tif e.Excerpt != \"\" {\n\t\t\tb.WriteString(\"**Excerpt**:\\n\")\n\t\t\tfor _, line := range splitLines(e.Excerpt) {\n\t\t\t\tfmt.Fprintf(&b, \"> %s\\n\", line)\n\t\t\t}\n\t\t}\n\t\tif e.Context != \"\" {\n\t\t\tfmt.Fprintf(&b, \"**Context**: %s\\n\", e.Context)\n\t\t}\n\t\tif e.Resolved != 0 {\n\t\t\tfmt.Fprintf(&b, \"**Resolved**: %d\\n\", e.Resolved)\n\t\t}\n\t}\n\treturn b.Bytes()\n}\n\nfunc splitLines(s string) []string {\n\tvar out []string\n\tstart := 0\n\tfor i := 0; i < len(s); i++ {\n\t\tif s[i] == '\\n' {\n\t\t\tout = append(out, s[start:i])\n\t\t\tstart = i + 1\n\t\t}\n\t}\n\treturn append(out, s[start:])\n}\n\nfunc sortedKeys[V any](m map[string]V) []string {\n\tout := make([]string, 0, len(m))\n\tfor k := range m {\n\t\tout = append(out, k)\n\t}\n\tsort.Strings(out)\n\treturn out\n}\n","numLines":308,"startLine":1,"totalLines":308}}}
